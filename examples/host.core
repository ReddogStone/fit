-- a program may extend a host name by putting the old one in the tail

[tie foreign solve host prelude] :>
  [number string bool true false add sub mul lt le gt ge eq concat show] := (host [foreign])
  fix := tie
  zero := $zero
  succ := $succ
  pi := 3
  old := add
  add := [
    [^zero right] :>
      right
    [(^succ left) right] :>
      (succ (add [left right]))
    | old
  ]

  [
    (add [2 3])
    (lt [2 3])
    (concat ["foo" (show [(add [10 2])])])
    (mul [2 pi])
    (add [(succ zero) zero])
  ]
