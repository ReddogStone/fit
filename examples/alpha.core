-- the contract between two models: value answers mapped through alpha must be the type answers

[tie foreign solve host prelude] :>
  [number string bool | hostRest] := (host [foreign])
  [same assertOne assertAgree | preludeRest] := (prelude [tie number string bool])
  fix := tie
  nat := $nat
  zero := $zero
  succ := $succ

  peano := [
    [zero succ fix] :>
      add := [
        [^zero right] :>
          right
        [(^succ left) right] :>
          (succ (add [left right]))
      ]
      fact := [
        ^zero :>
          (succ zero)
        (^succ below) :>
          (add [(succ below) (fact below)])
      ]
      [zero succ add fact]
  ]

  program := [
    [zero succ add fact] :>
      two := (succ (succ zero))
      [(add [two two]) (fact two) (add [(succ zero) #unknown])]
  ]

  alpha := [
    ^zero :>
      nat
    (^succ below) :>
      nat
  ]
  map := [
    [fn []] :>
      []
    [fn [head | tail]] :>
      [(fn head) | (map [fn tail])]
  ]

  values := (assertOne (solve (program (peano [zero succ tie]))))
  types := (assertAgree (solve (program (peano [
    nat
    [
      ^nat :>
        nat
    ]
    tie
  ]))))

  (same [(map [alpha values]) types])
