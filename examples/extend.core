-- a name on the right side of its own line: outside rule bodies it is the old binding, inside them it is the knot

[tie foreign answers host prelude] :>
  [number string bool true false add sub mul lt le gt ge eq concat show] := (host [foreign])
  fix := tie
  add := add |> old :>
    [
      [left right] :>
        (concat [(show [left]) (concat [(show [right]) (show [(old [left right])])])])
    ]
  length := [
    0
      <: []
    [head | tail] :>
      (sub [(length tail) -1])
  ]

  [(add [2 3]) (length [1 2])]
