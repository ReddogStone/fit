-- the host leaves as generators: one model runs the program, the other types it

[tie foreign answers host prelude] :>
  [number string bool true false add sub mul lt le gt ge eq concat show] := (host [foreign])
  [same one agree numberType stringType addType subType mulType ltType leType gtType geType eqType concatType showType] := (
    prelude
    [tie number string bool]
  )

  greeting := [
    [number string concat show add lt] :>
      greet := [
        name :>
          (concat ["hello " name])
      ]
      twice := [
        step :>
          [
            start :>
              (step (step start))
          ]
      ]
      inc := [
        count :>
          (add [count 1])
      ]
      [(greet "world") ((twice inc) 1) (lt [(inc 2) 4])]
  ]

  [
    (one (answers (greeting [number string concat show add lt])))
    (one (answers (greeting [numberType stringType concatType showType addType ltType])))
  ]
