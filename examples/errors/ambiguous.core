[tie foreign answers host prelude] :>
  [number string bool | hostRest] := (host [foreign])
  [same | preludeRest] := (prelude [tie number string bool])
  fix := tie
  apple := $apple
  banana := $banana
  append := [
    [[] rest] :>
      rest
    [[head | tail] rest] :>
      [head | (append [tail rest])]
  ]

  [(same [(append [#front #back]) [apple banana]]) #front #back]
