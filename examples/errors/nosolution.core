[tie foreign solve host prelude] :>
  [number string bool | hostRest] := (host [foreign])
  [same | preludeRest] := (prelude [tie number string bool])
  fix := tie
  apple := $apple
  banana := $banana
  cherry := $cherry
  append := <
    [[] rest] :>
      rest
    [[head | tail] rest] :>
      [head | (append [tail rest])]
  >

  (same [(append [#front [cherry]]) [apple banana]])
