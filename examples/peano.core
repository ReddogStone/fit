-- an algebra over its generators, a program over the algebra's exports, two models of the generators

[tie foreign solve host prelude] :>
  [number string bool | hostRest] := (host [foreign])
  [same assertOne assertAgree | preludeRest] := (prelude [tie number string bool])
  nat := $nat

  peano := [
    [zero succ fix] :>
      add := [
        [^zero right] :>
          right
        [(^succ left) right] :>
          (succ (add [left right]))
      ]
      mul := [
        [^zero right] :>
          zero
        [(^succ left) right] :>
          (add [right (mul [left right])])
      ]
      fact := [
        ^zero :>
          (succ zero)
        (^succ below) :>
          (mul [(succ below) (fact below)])
      ]
      [add fact]
  ]

  program := [
    [[zero succ] [add fact]] :>
      two := (succ (succ zero))
      three := (succ two)
      [(add [two two]) (fact three)]
  ]

  run := [
    [zero succ] :>
      (program [[zero succ] (peano [zero succ tie])])
  ]

  readWith := [
    assertion :> [
      model :>
        (assertion (solve (run model)))
    ]
  ]
  readValues := (readWith assertOne)
  readTypes := (readWith assertAgree)

  zero := $zero
  succ := $succ
  valueModel := [zero succ]
  typeModel := [
    nat
    [
      ^nat :>
        nat
    ]
  ]

  [value1 value2] := (readValues valueModel)
  [type1 type2] := (readTypes typeModel)

  four := (succ (succ (succ (succ zero))))
  six := (succ (succ (succ (succ (succ (succ zero))))))

  [
    (same [value1 four])
    (same [value2 six])
    (same [type1 nat])
    (same [type2 nat])
  ]
